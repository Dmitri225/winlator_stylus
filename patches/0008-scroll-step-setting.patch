                         android:layout_width="match_parent"
                         android:entries="@array/stylus_drag_mode_entries" />
 
+                    <LinearLayout
+                        android:id="@+id/LLStylusScrollStep"
+                        android:layout_width="match_parent"
+                        android:layout_height="wrap_content"
+                        android:orientation="vertical"
+                        android:layout_marginTop="8dp"
+                        android:visibility="gone">
+
+                        <TextView
+                            android:layout_width="wrap_content"
+                            android:layout_height="wrap_content"
+                            android:text="@string/stylus_scroll_step" />
+
+                        <com.winlator.widget.SeekBar
+                            android:id="@+id/SBStylusScrollStep"
+                            android:layout_width="match_parent"
+                            android:layout_height="wrap_content"
+                            app:suffix=" px"
+                            app:step="4"
+                            app:minValue="8"
+                            app:maxValue="128" />
+                    </LinearLayout>
+
                     <View style="@style/FieldSeparator" />
 
                     <CheckBox
