diff --git a/app/src/main/java/com/winlator/container/Container.java b/app/src/main/java/com/winlator/container/Container.java
index 2086786..580db5a 100644
--- a/app/src/main/java/com/winlator/container/Container.java
+++ b/app/src/main/java/com/winlator/container/Container.java
@@ -21,6 +21,10 @@ public class Container {
     public static final String DEFAULT_SCREEN_SIZE = "1280x720";
     public static final String DEFAULT_AUDIO_DRIVER = AudioDrivers.ALSA;
     public static final String DEFAULT_DXWRAPPER = DXWrappers.DXVK;
+    // Used only when creating a new container (existing ones keep their settings):
+    // WineD3D with the GDI renderer, which works for 2D DirectDraw games like HoMM3/HotA.
+    public static final String NEW_CONTAINER_DXWRAPPER = DXWrappers.WINED3D;
+    public static final String NEW_CONTAINER_DXWRAPPER_CONFIG = "renderer=gdi|";
     public static final String DEFAULT_WINCOMPONENTS = "direct3d=1,directsound=1,directmusic=1,directshow=0,directplay=0,xaudio=1,vcrun2005=0,vcrun2010=1,wmdecoder=1";
     public static final String FALLBACK_WINCOMPONENTS = "direct3d=0,directsound=0,directmusic=0,directshow=0,directplay=0,xaudio=0,vcrun2005=0,vcrun2010=0,wmdecoder=0";
     public static final String DEFAULT_DRIVES = "D:"+AppUtils.DIRECTORY_DOWNLOADS +"E:"+AppUtils.INTERNAL_STORAGE;
diff --git a/app/src/main/java/com/winlator/widget/TouchpadView.java b/app/src/main/java/com/winlator/widget/TouchpadView.java
index e12901f..ac1708d 100644
--- a/app/src/main/java/com/winlator/widget/TouchpadView.java
+++ b/app/src/main/java/com/winlator/widget/TouchpadView.java
@@ -40,6 +40,7 @@ public class TouchpadView extends View implements View.OnCapturedPointerListener
     private boolean pointerButtonLeftEnabled = true;
     private boolean pointerButtonRightEnabled = true;
     private boolean moveCursorToTouchpoint = false;
+    private boolean syncCursorOnFingerTap = true;
     private Finger fingerPointerButtonLeft;
     private Finger fingerPointerButtonRight;
     private float scrollAccumY = 0;
@@ -129,16 +130,36 @@ public class TouchpadView extends View implements View.OnCapturedPointerListener
         updateXform(w, h, xServer.screenInfo.width, xServer.screenInfo.height);
     }
 
+    private boolean xformFullscreen = false;
+    private int xformOuterWidth, xformOuterHeight;
+
     private void updateXform(int outerWidth, int outerHeight, int innerWidth, int innerHeight) {
         ViewTransformation viewTransformation = new ViewTransformation();
         viewTransformation.update(outerWidth, outerHeight, innerWidth, innerHeight);
 
+        xformFullscreen = xServer.getRenderer().isFullscreen();
+        xformOuterWidth = outerWidth;
+        xformOuterHeight = outerHeight;
+
         float invAspect = 1.0f / viewTransformation.aspect;
-        if (!xServer.getRenderer().isFullscreen()) {
+        if (!xformFullscreen) {
             XForm.makeTranslation(xform, -viewTransformation.viewOffsetX, -viewTransformation.viewOffsetY);
             XForm.scale(xform, invAspect, invAspect);
         }
-        else XForm.makeScale(xform, invAspect, invAspect);
+        else {
+            // "Fullscreen" stretches the X screen over the whole surface (GLRenderer sets the
+            // viewport to the full view), so X and Y scale independently.
+            XForm.makeScale(xform, (float)innerWidth / outerWidth, (float)innerHeight / outerHeight);
+        }
+    }
+
+    /** Fullscreen is toggled from the drawer menu without a size change: keep the mapping in sync. */
+    private void ensureXform() {
+        int w = getWidth() > 0 ? getWidth() : AppUtils.getScreenWidth();
+        int h = getHeight() > 0 ? getHeight() : AppUtils.getScreenHeight();
+        if (xServer.getRenderer().isFullscreen() != xformFullscreen || w != xformOuterWidth || h != xformOuterHeight) {
+            updateXform(w, h, xServer.screenInfo.width, xServer.screenInfo.height);
+        }
     }
 
     private class Finger {
@@ -192,6 +213,7 @@ public class TouchpadView extends View implements View.OnCapturedPointerListener
 
     @Override
     public boolean onTouchEvent(MotionEvent event) {
+        ensureXform();
         int actionIndex = event.getActionIndex();
         int pointerId = event.getPointerId(actionIndex);
         int actionMasked = event.getActionMasked();
@@ -266,7 +288,10 @@ public class TouchpadView extends View implements View.OnCapturedPointerListener
         switch (numFingers) {
             case 1:
                 if (finger1.isTap()) {
-                    if (moveCursorToTouchpoint) xServer.injectPointerMove(finger1.x, finger1.y);
+                    // tap = click where the finger is, not where the cursor happened to be
+                    if (moveCursorToTouchpoint || (syncCursorOnFingerTap && !xServer.isRelativeMouseMovement())) {
+                        xServer.injectPointerMove(finger1.x, finger1.y);
+                    }
                     pressPointerButtonLeft(finger1);
                 }
                 break;
@@ -337,6 +362,7 @@ public class TouchpadView extends View implements View.OnCapturedPointerListener
     }
 
     public void mouseMove(float x, float y, int action) {
+        ensureXform();
         switch (action) {
             case MotionEvent.ACTION_DOWN:
                 mouseMoveFinger = new Finger(x, y);
@@ -421,11 +447,16 @@ public class TouchpadView extends View implements View.OnCapturedPointerListener
         return moveCursorToTouchpoint;
     }
 
+    public void setSyncCursorOnFingerTap(boolean syncCursorOnFingerTap) {
+        this.syncCursorOnFingerTap = syncCursorOnFingerTap;
+    }
+
     public void setMoveCursorToTouchpoint(boolean moveCursorToTouchpoint) {
         this.moveCursorToTouchpoint = moveCursorToTouchpoint;
     }
 
     public boolean onExternalMouseEvent(MotionEvent event) {
+        ensureXform();
         if (stylusEnabled && isEnabled() && isStylusPointer(event, 0)) return handleStylusGenericEvent(event);
         boolean handled = false;
         if (isEnabled() && event.isFromSource(InputDevice.SOURCE_MOUSE)) {
@@ -472,6 +503,7 @@ public class TouchpadView extends View implements View.OnCapturedPointerListener
     }
 
     public float[] computeDeltaPoint(float lastX, float lastY, float x, float y) {
+        ensureXform();
         final float[] result = {0, 0};
 
         XForm.transformPoint(xform, lastX, lastY, result);
