+    private void onFingerLongPress() {
+        Finger f = fingerLongPress;
+        if (f == null || numFingers != 1 || !isEnabled() || !pointerButtonRightEnabled) return;
+        if (syncCursorOnFingerTap && !xServer.isRelativeMouseMovement()) xServer.injectPointerMove(f.x, f.y);
+        if (!xServer.pointer.isButtonPressed(Pointer.Button.BUTTON_RIGHT)) xServer.injectPointerButtonPress(Pointer.Button.BUTTON_RIGHT);
+        fingerLongPressRmbHeld = true;
+        performHapticFeedback(HapticFeedbackConstants.LONG_PRESS, HapticFeedbackConstants.FLAG_IGNORE_VIEW_SETTING);
+    }
+
+    /** Stops a pending finger long press and releases the right button if it was engaged. */
+    private void fingerLongPressCancel() {
+        removeCallbacks(fingerLongPressRunnable);
+        fingerLongPress = null;
+        if (fingerLongPressRmbHeld) {
+            fingerLongPressRmbHeld = false;
+            if (xServer.pointer.isButtonPressed(Pointer.Button.BUTTON_RIGHT)) xServer.injectPointerButtonRelease(Pointer.Button.BUTTON_RIGHT);
+        }
+    }
+
+    public void setFingerLongPressRightClick(boolean fingerLongPressRightClick) {
+        this.fingerLongPressRightClick = fingerLongPressRightClick;
+    }
+
     public void setSyncCursorOnFingerTap(boolean syncCursorOnFingerTap) {
         this.syncCursorOnFingerTap = syncCursorOnFingerTap;
     }
