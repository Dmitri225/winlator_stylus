+                    // defer LMB: short tap = LMB click, movement = LMB drag or map scroll,
                     // holding still for N ms = RMB held until the pen is lifted
                     stylusPendingLeft = true;
-                    postDelayed(stylusLongPressRunnable, stylusLongPressMillis);
+                    stylusScrolling = false;
+                    if (stylusRightButtonMode == STYLUS_RMB_MODE_LONG_PRESS) postDelayed(stylusLongPressRunnable, stylusLongPressMillis);
                 }
                 else {
                     stylusPressTipButton(Pointer.Button.BUTTON_LEFT);
@@ -656,8 +703,24 @@ public class TouchpadView extends View implements View.OnCapturedPointerListener
                 break;
             case MotionEvent.ACTION_MOVE:
                 if (!stylusTipDown) break;
