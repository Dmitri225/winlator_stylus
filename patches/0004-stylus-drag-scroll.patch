+    /**
+     * "Grab and drag" map scrolling: converts pen movement into arrow key taps, one tap per
+     * STYLUS_SCROLL_STEP pixels. Dragging right moves the map content right (view goes left).
+     */
+    private void stylusScrollTo(float viewX, float viewY) {
+        float[] p = XForm.transformPoint(xform, viewX, viewY);
+        stylusScrollAccumX += p[0] - stylusScrollLastX;
+        stylusScrollAccumY += p[1] - stylusScrollLastY;
+        stylusScrollLastX = p[0];
+        stylusScrollLastY = p[1];
+        boolean inverted = stylusDragMode == STYLUS_DRAG_MODE_SCROLL_KEYS_INVERTED;
+
+        while (Math.abs(stylusScrollAccumX) >= STYLUS_SCROLL_STEP) {
+            boolean right = stylusScrollAccumX > 0;
+            stylusScrollAccumX -= right ? STYLUS_SCROLL_STEP : -STYLUS_SCROLL_STEP;
+            stylusTapKey((right ^ inverted) ? XKeycode.KEY_LEFT : XKeycode.KEY_RIGHT);
+        }
+        while (Math.abs(stylusScrollAccumY) >= STYLUS_SCROLL_STEP) {
+            boolean down = stylusScrollAccumY > 0;
+            stylusScrollAccumY -= down ? STYLUS_SCROLL_STEP : -STYLUS_SCROLL_STEP;
+            stylusTapKey((down ^ inverted) ? XKeycode.KEY_UP : XKeycode.KEY_DOWN);
+        }
+    }
+
+    private void stylusTapKey(final XKeycode key) {
+        long now = SystemClock.uptimeMillis();
+        long t = Math.max(now, stylusNextKeyTapTime);
+        if (t - now > STYLUS_SCROLL_MAX_BACKLOG) return; // pen moves faster than the game scrolls
+        stylusNextKeyTapTime = t + STYLUS_SCROLL_KEY_INTERVAL;
+        Handler h = stylusHandler();
+        h.postAtTime(() -> xServer.injectKeyPress(key), t);
+        h.postAtTime(() -> xServer.injectKeyRelease(key), t + STYLUS_SCROLL_KEY_INTERVAL / 2);
+    }
+
     private boolean handleStylusTouchEvent(MotionEvent event) {
         stylusLastEventTime = System.currentTimeMillis();
         int actionMasked = event.getActionMasked();
@@ -644,11 +690,12 @@ public class TouchpadView extends View implements View.OnCapturedPointerListener
                 else if (event.getToolType(index) == MotionEvent.TOOL_TYPE_ERASER) {
