-                if (stylusPendingLeft && Math.hypot(viewX - stylusDownX, viewY - stylusDownY) > touchSlop) {
+                if (stylusPendingLeft && stylusDragMode != STYLUS_DRAG_MODE_LEFT_BUTTON &&
+                    Math.hypot(viewX - stylusDownX, viewY - stylusDownY) > touchSlop) {
+                    removeCallbacks(stylusLongPressRunnable);
+                    stylusPendingLeft = false;
+                    stylusScrolling = true;
+                    stylusMoveTo(stylusDownX, stylusDownY);
+                    float[] p = XForm.transformPoint(xform, stylusDownX, stylusDownY);
+                    stylusScrollLastX = p[0];
+                    stylusScrollLastY = p[1];
+                    stylusScrollAccumX = stylusScrollAccumY = 0;
+                    stylusScrollTo(viewX, viewY);
+                }
+                else if (stylusPendingLeft && Math.hypot(viewX - stylusDownX, viewY - stylusDownY) > touchSlop) {
                     removeCallbacks(stylusLongPressRunnable);
                     stylusPendingLeft = false;
                     // start the drag where the pen landed, then catch up to the current position
@@ -677,6 +740,7 @@ public class TouchpadView extends View implements View.OnCapturedPointerListener
             case MotionEvent.ACTION_POINTER_UP:
             case MotionEvent.ACTION_CANCEL:
