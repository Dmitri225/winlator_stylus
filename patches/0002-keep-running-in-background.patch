@@ -307,4 +307,6 @@
     <string name="stylus_palm_rejection">Ignorar toques dos dedos ao usar a caneta</string>
     <string name="stylus_rmb_side_button">Botão lateral + toque</string>
     <string name="stylus_rmb_long_press">Toque longo (segurar a caneta)</string>
