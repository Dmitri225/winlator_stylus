diff --git a/app/src/main/java/com/winlator/xenvironment/RootFSRelocator.java b/app/src/main/java/com/winlator/xenvironment/RootFSRelocator.java
new file mode 100644
index 0000000..842beba
--- /dev/null
+++ b/app/src/main/java/com/winlator/xenvironment/RootFSRelocator.java
@@ -0,0 +1,135 @@
+package com.winlator.xenvironment;
+
+import android.util.Log;
+
+import java.io.BufferedInputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.RandomAccessFile;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Makes the rootfs independent of the Android user it is installed for (Knox Secure Folder,
+ * work profile, any secondary user).
+ *
+ * The bundled glibc userland, box64, Wine and graphics drivers are built with the absolute prefix
+ * /data/data/com.winlator/files/rootfs: ELF interpreter (PT_INTERP), RUNPATH, ld.so search paths,
+ * Wine's server dir, X11/Vortek socket paths, fontconfig, ALSA... /data/data is a link to
+ * /data/user/0, so for any other user (Knox = user 150) every one of these points into another
+ * user's private storage and box64 cannot even be executed.
+ *
+ * The prefix is rewritten in place to a path of exactly the same length that resolves through
+ * file descriptor 9, which the guest launcher opens on the real rootfs directory of the current
+ * user and which every guest process inherits:
+ *
+ *   /data/data/com.winlator/files/rootfs  ->  /proc/self/fd/9//./././././././././.
+ *
+ * Same length keeps binaries valid (no offsets move). Works for user 0 as well.
+ */
+public abstract class RootFSRelocator {
+    private static final String TAG = "RootFSRelocator";
+    public static final int ROOTFS_FD = 9;
+    public static final String ENV_ROOTFS_DIR = "WINLATOR_ROOTFS_DIR";
+    private static final byte[] OLD_PREFIX = "/data/data/com.winlator/files/rootfs".getBytes(StandardCharsets.US_ASCII);
+    private static final byte[] NEW_PREFIX = "/proc/self/fd/9//./././././././././.".getBytes(StandardCharsets.US_ASCII);
+    private static final int VERSION = 1;
+    private static final int BUFFER_SIZE = 1 << 20;
+
+    static {
+        if (OLD_PREFIX.length != NEW_PREFIX.length) throw new AssertionError("relocation prefixes must have the same length");
+    }
+
+    /** Shell snippet run as: sh -c SNIPPET sh <program> <args...>; keeps the pid (exec) and passes fd 9 on. */
+    public static final String LAUNCH_SNIPPET = "exec \"$@\" "+ROOTFS_FD+"<\"$"+ENV_ROOTFS_DIR+"\"";
+
+    /** Rewrites the prefix inside one regular file. Returns false only if the file could not be patched. */
+    public static boolean relocateFile(File file) {
+        try {
+            if (!file.isFile() || Files.isSymbolicLink(file.toPath()) || file.length() < OLD_PREFIX.length) return true;
+            List<Long> offsets = findOffsets(file);
+            if (offsets.isEmpty()) return true;
+            try (RandomAccessFile raf = new RandomAccessFile(file, "rw")) {
+                for (long offset : offsets) {
+                    raf.seek(offset);
+                    raf.write(NEW_PREFIX);
+                }
+            }
+            return true;
+        }
+        catch (IOException | SecurityException e) {
+            Log.w(TAG, "Unable to relocate "+file, e);
+            return false;
+        }
+    }
+
+    private static List<Long> findOffsets(File file) throws IOException {
+        ArrayList<Long> offsets = new ArrayList<>();
+        final int len = OLD_PREFIX.length;
+        byte[] buffer = new byte[BUFFER_SIZE + len];
+        int carry = 0;
+        long base = 0;
+        try (InputStream in = new BufferedInputStream(new FileInputStream(file), BUFFER_SIZE)) {
+            int read;
+            while ((read = in.read(buffer, carry, buffer.length - carry)) > 0) {
+                int total = carry + read;
+                int limit = total - len;
+                for (int i = 0; i <= limit; i++) {
+                    if (buffer[i] == '/' && matchesAt(buffer, i)) offsets.add(base + i);
+                }
+                int keep = Math.min(len - 1, total);
+                System.arraycopy(buffer, total - keep, buffer, 0, keep);
+                base += total - keep;
+                carry = keep;
+            }
+        }
+        return offsets;
+    }
+
+    private static boolean matchesAt(byte[] buffer, int start) {
+        for (int j = 1; j < OLD_PREFIX.length; j++) if (buffer[start + j] != OLD_PREFIX[j]) return false;
+        return true;
+    }
+
+    /**
+     * One-time pass over an existing rootfs (installed by a build without relocation).
+     * Skips symlinks, /home (containers with their drive_c and games) and /tmp.
+     */
+    public static void relocateRootFSOnce(RootFS rootFS) {
+        File rootDir = rootFS.getRootDir();
+        File marker = new File(rootDir, ".winlator/.relocated");
+        if (marker.isFile()) return;
+
+        long started = System.currentTimeMillis();
+        boolean ok = relocateTree(rootDir, rootDir);
+        if (ok) {
+            try {
+                marker.getParentFile().mkdirs();
+                java.nio.file.Files.write(marker.toPath(), String.valueOf(VERSION).getBytes(StandardCharsets.US_ASCII));
+            }
+            catch (IOException e) {
+                Log.w(TAG, "Unable to write relocation marker", e);
+            }
+        }
+        Log.i(TAG, "rootfs relocation pass: "+(ok ? "done" : "incomplete")+" in "+(System.currentTimeMillis() - started)+" ms");
+    }
+
+    private static boolean relocateTree(File dir, File rootDir) {
+        File[] files = dir.listFiles();
+        if (files == null) return true;
+        boolean ok = true;
+        for (File file : files) {
+            if (Files.isSymbolicLink(file.toPath())) continue;
+            if (file.isDirectory()) {
+                if (dir.equals(rootDir) && (file.getName().equals("home") || file.getName().equals("tmp"))) continue;
+                ok &= relocateTree(file, rootDir);
+            }
+            else ok &= relocateFile(file);
+        }
+        return ok;
+    }
+}
