From 1d34dd4c9bd6aaaa6be59c3e66bc533181b70134 Mon Sep 17 00:00:00 2001
From: Dmitri <dms202575p@gmail.com>
Date: Tue, 3 Nov 2026 13:47:39 +0000
Subject: [PATCH] Stylus map scroll: send Ctrl+arrows instead of plain arrows

In HoMM3/HotA plain arrow keys move the selected hero (so dragging the
map also walked the hero along the plotted path); Ctrl+arrows scroll the
adventure map. Ctrl is pressed/released around every tap so it can't stick.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018cLUKUNDhFWb9gSFtJ7vW4
---
 .../java/com/winlator/widget/TouchpadView.java     | 14 +++++++++++---
 app/src/main/res/values-pt/strings.xml             |  2 +-
 app/src/main/res/values-ru/strings.xml             |  2 +-
 app/src/main/res/values/strings.xml                |  2 +-
 4 files changed, 14 insertions(+), 6 deletions(-)

diff --git a/app/src/main/java/com/winlator/widget/TouchpadView.java b/app/src/main/java/com/winlator/widget/TouchpadView.java
index ed6280b..2ae0a0b 100644
--- a/app/src/main/java/com/winlator/widget/TouchpadView.java
+++ b/app/src/main/java/com/winlator/widget/TouchpadView.java
@@ -701,7 +701,7 @@ public class TouchpadView extends View implements View.OnCapturedPointerListener
     }
 
     /**
-     * "Grab and drag" map scrolling: converts pen movement into arrow key taps, one tap per
+     * "Grab and drag" map scrolling: converts pen movement into Ctrl+arrow key taps, one tap per
      * STYLUS_SCROLL_STEP pixels. Dragging right moves the map content right (view goes left).
      */
     private void stylusScrollTo(float viewX, float viewY) {
@@ -730,8 +730,16 @@ public class TouchpadView extends View implements View.OnCapturedPointerListener
         if (t - now > STYLUS_SCROLL_MAX_BACKLOG) return; // pen moves faster than the game scrolls
         stylusNextKeyTapTime = t + STYLUS_SCROLL_KEY_INTERVAL;
         Handler h = stylusHandler();
-        h.postAtTime(() -> xServer.injectKeyPress(key), t);
-        h.postAtTime(() -> xServer.injectKeyRelease(key), t + STYLUS_SCROLL_KEY_INTERVAL / 2);
+        // Ctrl+arrow: in HoMM3/HotA plain arrows MOVE the selected hero, Ctrl+arrows scroll the map.
+        // Each tap is self-contained (Ctrl pressed and released around it), so Ctrl can never stick.
+        h.postAtTime(() -> {
+            xServer.injectKeyPress(XKeycode.KEY_CTRL_L);
+            xServer.injectKeyPress(key);
+        }, t);
+        h.postAtTime(() -> {
+            xServer.injectKeyRelease(key);
+            xServer.injectKeyRelease(XKeycode.KEY_CTRL_L);
+        }, t + STYLUS_SCROLL_KEY_INTERVAL / 2);
     }
 
     private boolean handleStylusTouchEvent(MotionEvent event) {
