         this.openFileCallback = openFileCallback;
     }
 
+    /**
+     * With Background Protection on, ask Android/One UI once to exempt Winlator from battery
+     * optimization ("Unrestricted"), so the foreground service is not throttled or frozen.
+     */
+    private void requestIgnoreBatteryOptimizationsOnce() {
+        try {
+            if (!preferences.getBoolean("enable_background_protection", true)) return;
+            if (preferences.getBoolean("battery_optimization_asked", false)) return;
+            // not while the storage permission dialog is up; we'll come back in onResume
+            if (ContextCompat.checkSelfPermission(this, Manifest.permission.WRITE_EXTERNAL_STORAGE) != PackageManager.PERMISSION_GRANTED) return;
+            android.os.PowerManager pm = (android.os.PowerManager)getSystemService(POWER_SERVICE);
+            if (pm == null || pm.isIgnoringBatteryOptimizations(getPackageName())) return;
+            preferences.edit().putBoolean("battery_optimization_asked", true).apply();
+            Intent intent = new Intent(android.provider.Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS);
+            intent.setData(android.net.Uri.parse("package:" + getPackageName()));
+            startActivity(intent);
+        }
+        catch (Exception e) {
+            android.util.Log.w("MainActivity", "Unable to request battery optimization exemption", e);
+        }
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        // asked here instead of on game start: leaving the game screen right as it starts
+        // would pause the container while Wine is booting
+        requestIgnoreBatteryOptimizationsOnce();
+    }
+
     private boolean requestAppPermissions() {
         if (ContextCompat.checkSelfPermission(this, Manifest.permission.WRITE_EXTERNAL_STORAGE) == PackageManager.PERMISSION_GRANTED &&
             ContextCompat.checkSelfPermission(this, Manifest.permission.READ_EXTERNAL_STORAGE) == PackageManager.PERMISSION_GRANTED) return false;
