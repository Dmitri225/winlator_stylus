+    // All X server injections from the stylus run on this thread, never on the UI thread:
+    // XServer.inject* takes the X server lock, and blocking the UI thread on it (pen hover
+    // sends 100+ events/s) can freeze Winlator ("app not responding") while the game loads.
+    private HandlerThread stylusInputThread;
+    private Handler stylusInputHandler;
+    private final Object stylusMoveLock = new Object();
+    private boolean stylusMovePosted = false;
+    private boolean stylusMoveAbsPending = false;
+    private int stylusMoveX, stylusMoveY, stylusMoveDx, stylusMoveDy;
+    private volatile int stylusLatestX = Integer.MIN_VALUE, stylusLatestY = Integer.MIN_VALUE;
+    private final Runnable stylusFlushMoveRunnable = this::stylusFlushMove;
     private final Runnable stylusLongPressRunnable = () -> {
         if (stylusTipDown && stylusPendingLeft) {
             stylusPendingLeft = false;
@@ -497,47 +510,110 @@ public class TouchpadView extends View implements View.OnCapturedPointerListener
         return stylusTipDown || (System.currentTimeMillis() - stylusLastEventTime) < STYLUS_PALM_REJECTION_MILLISECONDS;
