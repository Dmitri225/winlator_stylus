+    private Handler stylusHandler() {
+        if (stylusInputHandler == null) {
+            stylusInputThread = new HandlerThread("StylusInput");
+            stylusInputThread.start();
+            stylusInputHandler = new Handler(stylusInputThread.getLooper());
+        }
+        return stylusInputHandler;
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        super.onDetachedFromWindow();
+        if (stylusInputThread != null) {
+            stylusInputThread.quitSafely();
+            stylusInputThread = null;
+            stylusInputHandler = null;
+        }
+    }
+
+    /** Runs on the input thread: applies the latest coalesced pointer position/delta. */
+    private void stylusFlushMove() {
+        int x, y, dx, dy;
+        boolean abs;
+        synchronized (stylusMoveLock) {
+            stylusMovePosted = false;
+            abs = stylusMoveAbsPending;
+            x = stylusMoveX; y = stylusMoveY;
+            dx = stylusMoveDx; dy = stylusMoveDy;
+            stylusMoveAbsPending = false;
+            stylusMoveDx = stylusMoveDy = 0;
+        }
+        if (abs) xServer.injectPointerMove(x, y);
+        if (dx != 0 || dy != 0) xServer.getWinHandler().mouseEvent(MouseEventFlags.MOVE, dx, dy, 0);
+    }
+
     private void stylusMoveTo(float viewX, float viewY) {
         float[] p = XForm.transformPoint(xform, viewX, viewY);
         int x = (int)p[0];
         int y = (int)p[1];
-        if (xServer.isRelativeMouseMovement()) {
-            if (stylusLastX != Integer.MIN_VALUE) {
-                int dx = x - stylusLastX;
-                int dy = y - stylusLastY;
-                if (dx != 0 || dy != 0) xServer.getWinHandler().mouseEvent(MouseEventFlags.MOVE, dx, dy, 0);
+        boolean changed = false;
+        synchronized (stylusMoveLock) {
+            if (xServer.isRelativeMouseMovement()) {
+                if (stylusLastX != Integer.MIN_VALUE && (x != stylusLastX || y != stylusLastY)) {
+                    stylusMoveDx += x - stylusLastX;
+                    stylusMoveDy += y - stylusLastY;
+                    changed = true;
+                }
+            }
+            else if (x != stylusLastX || y != stylusLastY) {
+                stylusMoveX = stylusLatestX = x;
+                stylusMoveY = stylusLatestY = y;
+                stylusMoveAbsPending = true;
+                changed = true;
+            }
+            if (changed && !stylusMovePosted) {
+                stylusMovePosted = true;
+                stylusHandler().post(stylusFlushMoveRunnable);
             }
-        }
-        else if (x != stylusLastX || y != stylusLastY) {
-            xServer.injectPointerMove(x, y);
         }
         stylusLastX = x;
         stylusLastY = y;
     }
 
+    /** Button change at the current pen position, ordered after the moves queued before it. */
+    private void stylusPostButton(final Pointer.Button button, final boolean press, long delayMillis) {
+        final boolean abs = !xServer.isRelativeMouseMovement() && stylusLastX != Integer.MIN_VALUE;
+        final int x = stylusLastX, y = stylusLastY;
+        Runnable r = () -> {
+            // press exactly where the pen was when the button event happened...
+            if (abs && press) xServer.injectPointerMove(x, y);
+            boolean pressed = xServer.pointer.isButtonPressed(button);
+            if (press && !pressed) xServer.injectPointerButtonPress(button);
+            else if (!press && pressed) xServer.injectPointerButtonRelease(button);
+            // ...then catch up with wherever the pen is now (a coalesced move may have run earlier)
+            int lx = stylusLatestX, ly = stylusLatestY;
+            if (abs && press && lx != Integer.MIN_VALUE && (lx != x || ly != y)) xServer.injectPointerMove(lx, ly);
+        };
+        if (delayMillis > 0) stylusHandler().postDelayed(r, delayMillis);
+        else stylusHandler().post(r);
+    }
+
     private void stylusPressTipButton(Pointer.Button button) {
         stylusReleaseTipButton();
-        if (!xServer.pointer.isButtonPressed(button)) xServer.injectPointerButtonPress(button);
+        stylusPostButton(button, true, 0);
         stylusTipButton = button;
     }
 
     private void stylusReleaseTipButton() {
         if (stylusTipButton != null) {
-            if (xServer.pointer.isButtonPressed(stylusTipButton)) xServer.injectPointerButtonRelease(stylusTipButton);
+            stylusPostButton(stylusTipButton, false, 0);
             stylusTipButton = null;
         }
     }
 
     private void stylusClick(final Pointer.Button button) {
-        xServer.injectPointerButtonPress(button);
+        stylusPostButton(button, true, 0);
         // same 30ms gap the touchpad uses, so games that poll button state don't miss the click
-        postDelayed(() -> xServer.injectPointerButtonRelease(button), 30);
+        stylusPostButton(button, false, 30);
     }
 
     private void stylusReleaseHoverButton() {
         if (stylusHoverButtonDown) {
             stylusHoverButtonDown = false;
-            if (xServer.pointer.isButtonPressed(Pointer.Button.BUTTON_RIGHT)) xServer.injectPointerButtonRelease(Pointer.Button.BUTTON_RIGHT);
+            stylusPostButton(Pointer.Button.BUTTON_RIGHT, false, 0);
         }
     }
 
